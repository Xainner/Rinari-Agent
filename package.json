{
  "name": "rinari-agent",
  "private": true,
  "version": "0.2.0",
  "description": "Native desktop workspace for the Rinari Engine",
  "author": "Xainner",
  "homepage": "https://github.com/Xainner/Rinari-Agent",
  "main": "dist-electron/main.cjs",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "electron:install": "node node_modules/electron/install.js",
    "typecheck:electron": "tsc -p tsconfig.electron.json",
    "desktop:build": "node scripts/build-desktop.mjs",
    "desktop:dev": "node scripts/desktop-dev.mjs",
    "desktop:start": "electron dist-electron/main.cjs",
    "desktop:smoke": "node scripts/desktop-smoke.mjs",
    "desktop:parity": "node scripts/desktop-parity-e2e.mjs",
    "protocol:generate": "node scripts/generate-protocol.mjs",
    "protocol:check": "node scripts/generate-protocol.mjs --check",
    "parity:inventory": "node scripts/desktop-parity.mjs",
    "parity:check": "node scripts/desktop-parity.mjs --check",
    "browser:probe": "node scripts/browser-probe.mjs",
    "browser:vertical": "node scripts/browser-vertical.mjs",
    "installer:art": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/compose-installer-art.ps1",
    "setup:web:build": "npm run installer:art && vite build --config installer/setup/vite.config.ts",
    "setup:web:dev": "npm run installer:art && vite --config installer/setup/vite.config.ts",
    "setup:dev": "node scripts/run-setup-tauri.mjs dev",
    "setup:build": "node scripts/run-setup-tauri.mjs build --no-bundle",
    "package:engine": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/package-engine.ps1 -OutDir engine-dist",
    "package:hashes": "node scripts/hash-package-inputs.mjs",
    "package:payload": "npm run build && npm run desktop:build && electron-builder --win dir --x64 --publish never && powershell -NoProfile -ExecutionPolicy Bypass -File scripts/package-setup-payload.ps1",
    "package:update-metadata": "node scripts/generate-update-metadata.mjs",
    "updater:e2e": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/updater-e2e.ps1",
    "package:win": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/package-release.ps1",
    "package:win:staged": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/package-release.ps1 -SkipEngine"
  },
  "dependencies": {
    "@radix-ui/react-alert-dialog": "^1.1.23",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-separator": "^1.1.15",
    "@radix-ui/react-switch": "^1.3.7",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@tailwindcss/vite": "^4.3.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "electron-updater": "6.8.9",
    "framer-motion": "^13.2.0",
    "katex": "^0.18.7",
    "lucide-react": "^1.43.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-markdown": "^10.1.0",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "shiki": "^4.4.3",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "vaul": "^1.1.2",
    "virtua": "^0.51.2",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^6.0.2",
    "electron": "44.4.1",
    "electron-builder": "26.16.1",
    "jsdom": "^29.1.1",
    "typescript": "~6.0.3",
    "vite": "^8.0.16",
    "vitest": "^5.0.0"
  },
  "engines": {
    "node": ">=22.12.0",
    "npm": "^10"
  }
}
