{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Rinari Agent Setup",
  "version": "0.2.0",
  "identifier": "com.rinari.agent.setup",
  "mainBinaryName": "Rinari-Setup",
  "build": {
    "beforeDevCommand": "npm run setup:web:dev --prefix ../..",
    "devUrl": "http://localhost:1431",
    "beforeBuildCommand": "npm run setup:web:build --prefix ../..",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Rinari Agent Setup",
        "width": 1200,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "center": true,
        "decorations": false,
        "resizable": true,
        "maximizable": true,
        "shadow": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: data:; font-src 'self'; style-src 'self' 'unsafe-inline'; connect-src 'self' ipc: http://ipc.localhost; object-src 'none'; frame-src 'none'; base-uri 'none'; form-action 'none'"
    }
  },
  "bundle": {
    "active": false,
    "icon": ["../../../src-tauri/icons/icon.ico"]
  }
}
